# --- App (tenant-scoped, RLS-enforced) ---
DATABASE_URL=postgresql+psycopg://harboriq_app:harboriq_app_pass@localhost:5432/harboriq

# --- Service (BYPASSRLS; webhook resolution, public-token lookup, maintenance) ---
SERVICE_DATABASE_URL=postgresql+psycopg://harboriq_service:harboriq_service_pass@localhost:5432/harboriq

# --- Redis (Celery broker/result backend + rate limiting) ---
# docker-compose.yml's `redis` service and DEPLOYMENT.md both use this same
# default in-cluster; only change for a managed/external Redis.
REDIS_URL=redis://localhost:6379/0

# --- Stripe ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Crypto payments (Phase 18) ---
# Off by default. HarborIQ never custody-holds crypto; this enables
# Stripe-hosted stablecoin Checkout only after Stripe enables the payment
# method on the relevant platform/Connect account. CRYPTO_WEBHOOK_SECRET is
# required outside development so /webhooks/crypto can verify HMAC-SHA256.
CRYPTO_PAYMENTS_ENABLED=false
CRYPTO_WEBHOOK_SECRET=

# --- Asset tokenization (Phase 19, exploratory placeholder) ---
# Off by default and MUST stay off in production until outside securities
# counsel review. Draft-registration only — no issuance/transfer/trading.
ASSET_TOKENIZATION_ENABLED=false

# --- Auth ---
# Signing key for access-token JWTs (HS256). Generate with: openssl rand -hex 32
# The placeholder below is REJECTED at startup unless APP_ENV=development.
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
JWT_ALGORITHM=HS256
JWT_ISSUER=harboriq
# Access tokens are stateless, so this is also the worst-case delay between
# revoking a session and the old access token stopping to work.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh tokens are opaque, stored hashed, and rotated on every use.
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_MIN_LENGTH=12

# --- Auth hardening: rate limiting + account lockout ---
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_REQUESTS_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60
# How long an invite link stays valid before it must be reissued.
INVITE_TTL_HOURS=168

# --- MFA (TOTP secret encryption) ---
# Fernet key encrypting stored TOTP secrets at rest. Empty is allowed ONLY in
# development (a fixed dev-only placeholder is used). Non-development
# environments MUST set a real key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# --- Auth cookies ---
# Names for the refresh-token and CSRF cookies. Defaults work out of the box;
# override only if a reverse proxy/CDN already reserves these names. Note:
# a `__Host-` prefixed name additionally requires Secure (true outside
# development) and forbids a Domain attribute (never set here).
REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/api/v1/auth
CSRF_COOKIE_NAME=csrf_token

# --- Email transport ---
# Leave SMTP_HOST empty to use the console-fallback transport (logs the full
# message at INFO instead of sending it) -- the default for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@harboriq.app
# Used to build links embedded in outbound email (password reset, invites).
# Point this at the frontend's deployed origin, not the API's.
APP_BASE_URL=http://localhost:5173

# --- SMS transport (Phase 11) ---
# Empty TWILIO_ACCOUNT_SID (the dev default) means "console transport" (logs
# the message instead of sending it), the same graceful-degrade pattern as
# SMTP_HOST/STRIPE_API_KEY above. Set all three to enable real SMS via
# Twilio's REST API.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Field location pings (mobile technician GPS) ---
# Rate limit on POST location-ping ingestion, stopping a compromised session
# from flooding spoofed coordinates onto the dispatch board.
LOCATION_PING_RATE_LIMIT_PER_WINDOW=30
LOCATION_PING_RATE_LIMIT_WINDOW_SECONDS=60
# A ping implying travel faster than this (km/h) since the prior ping is
# flagged, not rejected -- legitimate cold-start GPS jumps still land.
LOCATION_PING_MAX_PLAUSIBLE_SPEED_KMH=250.0
# Only run the speed-plausibility check when the prior ping is this fresh;
# older gaps are treated as a new trip (device off overnight, flight, etc.).
LOCATION_PING_PLAUSIBILITY_WINDOW_SECONDS=7200

# --- Offline sync queue (PWA field app) ---
# A queued mutation with a client_queued_at older than the hard max is
# rejected; ages above the warn threshold are accepted but structured-logged.
OFFLINE_QUEUE_MAX_AGE_SECONDS=1209600
OFFLINE_QUEUE_WARN_AGE_SECONDS=259200
# Allow a small future skew for client clocks that run slightly fast.
OFFLINE_QUEUE_FUTURE_SKEW_SECONDS=300

# --- Off-host database backups (Phase 16) ---
# Not read by the FastAPI app itself -- documented here purely so
# scripts/backup_db_s3.sh's required env vars are discoverable; the script
# reads them directly. Empty BACKUP_S3_BUCKET => local-only backups
# (pg_dump + gzip to BACKUP_OUTPUT_DIR). See docs/DEPLOYMENT.md.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=harboriq-backups
# REHEARSAL_ADMIN_URL is a separate, CI/ops-only variable consumed by
# scripts/rehearse_backup_restore.sh (superuser-or-CREATEDB connection URL
# used to spin up a scratch DB for a real dump+restore drill). It is never
# read by the FastAPI app and is intentionally NOT set here -- it must
# point at a throwaway/test Postgres instance, never a production database,
# since the rehearsal script creates and drops a scratch DB on that server.
# CI sets it inline in .github/workflows/ci.yml to the ephemeral test
# Postgres service. Do not add this to a real deployment's .env.

# --- Observability ---
# Leave empty to disable Sentry entirely (no import, no init call -- the
# same graceful-degrade pattern as STRIPE_API_KEY/SMTP_HOST above). Set to a
# real Sentry DSN to turn on error + performance reporting. See
# docs/DEPLOYMENT.md, "Observability (Sentry)".
SENTRY_DSN=

# Shared secret for GET /metrics (Authorization: Bearer <token>). Empty is
# allowed only when APP_ENV=development (open scrape for local Prometheus).
# Outside development the process refuses to start without a non-empty value
# of at least 16 bytes. Generate with: openssl rand -hex 32
# Prometheus: scrape_configs[].authorization.credentials or bearer_token_file.
METRICS_TOKEN=

# --- CORS ---
# Comma-separated list of origins allowed to call the API cross-origin (the
# React frontend's dev server / deployed origin). Defaults to the Vite dev
# server so `npm run dev` in frontend/ works out of the box.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Marketing leads (public GTM / trial signup) ---
# Internal notify address for POST /api/v1/public/leads. Empty = store only.
MARKETING_LEAD_NOTIFY_TO=coryelliott19@icloud.com
# Bearer token for GET /api/v1/public/leads. Empty disables list (401).
# Generate with: openssl rand -hex 32
MARKETING_LEADS_ADMIN_TOKEN=
MARKETING_LEAD_RATE_LIMIT_PER_WINDOW=5
MARKETING_LEAD_RATE_LIMIT_WINDOW_SECONDS=600

# --- Cloudflare (CDN/WAF) ---
# Not read by the FastAPI app itself -- the same discoverability-only
# pattern app/core/config.py already uses for backup_s3_bucket/
# backup_s3_prefix (those are documented on the Settings model purely so
# scripts/backup_db_s3.sh's required env vars are discoverable; they are
# read by that shell script directly, not by pydantic-settings). These two
# vars exist here purely so scripts/provision_cloudflare.py has somewhere
# documented to read them from. Leave both empty until a Cloudflare
# account + zone exist -- see docs/EXTERNAL_ACCOUNTS_SETUP.md for signup
# steps and docs/DEPLOYMENT.md's "CDN / WAF (Cloudflare)" section for what
# the script configures. UNVALIDATED against a live account; dry-run and
# review before trusting it in production.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
