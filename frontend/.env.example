# Base URL of the HarborIQ API (no trailing slash, no /api/v1 suffix — the
# client appends that itself). Vite only exposes env vars prefixed VITE_ to
# client code, and inlines them at build time.
VITE_API_URL=http://localhost:8000

# Public marketing site hosting /#/terms and /#/privacy (linked from signup).
# Switch to https://harboriq.com once that domain serves the marketing site.
VITE_MARKETING_SITE_URL=https://harboriq-gamma.vercel.app

# Build the separate public website with npm run build:marketing. It does not
# mount staff authentication or the field-app service worker.
# VITE_PUBLIC_SITE_URL must be an owner-verified HTTPS origin before indexing.
# Leave unset on previews; never assume harboriq.com is attached to this build.
# VITE_PUBLIC_SITE_URL=https://your-verified-marketing-domain.example
# VITE_API_URL=/ uses a host-managed same-origin /api/* proxy.
