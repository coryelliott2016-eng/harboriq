# Base URL of the HarborIQ API (no trailing slash, no /api/v1 suffix — the
# client appends that itself). Vite only exposes env vars prefixed VITE_ to
# client code, and inlines them at build time.
VITE_API_URL=http://localhost:8000

# Public marketing site hosting /#/terms and /#/privacy (linked from signup).
# Switch to https://harboriq.com once that domain serves the marketing site.
VITE_MARKETING_SITE_URL=https://harboriq-gamma.vercel.app
